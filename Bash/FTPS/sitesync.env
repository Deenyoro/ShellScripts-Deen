# sitesync.env — required environment for sitesync.sh.
# Chmod this file 600: it contains a password.

# FTPS
FTPS_SERVER="your-ftps-server-url"                 # e.g. ftps.example.com
FTPS_USER="your-ftps-username"
FTPS_PASS="your-ftps-password"
FTPS_REMOTE_DIR="remote-directory-path"            # e.g. /site/wwwroot

# Paths
LOCAL_REPO="path-to-local-repo"                    # absolute path recommended
SSH_KEY_PATH="path-to-ssh-private-key"             # e.g. $HOME/.ssh/id_ed25519

# Git
GIT_REMOTE_URL="git-repo-ssh-url"                  # SSH URL (git@github.com:org/repo.git)
GIT_USER_NAME="your-git-username"
GIT_USER_EMAIL="your-git-email"
BRANCH="main"

# Optional tuning
# SSH_KEY_EMAIL="$GIT_USER_EMAIL"   # comment for new ssh-keygen
# FTPS_PARALLEL=2                   # parallel streams for lftp mirror
# ALLOW_FORCE_PUSH=0                # set to 1 to allow --force-with-lease fallback

# FTPS Configuration
FTPS_SERVER="your-ftps-server-url"                 # The URL of your FTPS server
FTPS_USER="your-ftps-username"                     # Your FTPS username
FTPS_PASS="your-ftps-password"                     # Your FTPS password (keep this secure)
FTPS_REMOTE_DIR="remote-directory-path"            # The path to the directory on the FTPS server you want to sync (e.g., /site/wwwroot)

# Script Paths
LOCAL_REPO="path-to-local-repo"                    # The local path to your Git repository
SSH_KEY_PATH="path-to-ssh-private-key"             # The path to your SSH private key (e.g., ./.ssh/id_rsa)

# Git Configuration
GIT_REMOTE_URL="git-repo-ssh-url"                  # The SSH URL of your Git repository
GIT_USER_NAME="your-git-username"                  # Your Git username
GIT_USER_EMAIL="your-git-email"                    # Your Git email address
BRANCH="branch-name"                               # The branch you want to work with (e.g., main)

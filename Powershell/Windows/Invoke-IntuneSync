# Invoke-IntuneSync.ps1

# -------------------------------
# Script to Trigger Intune Policy Sync for Logged-In User
# -------------------------------

# Function to log messages
function Log-Message {
    param (
        [string]$Message
    )
    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    Write-Output "$timestamp - $Message"
}

# Define log directory and file
$LogDir = "C:\MDM"
$LogFile = Join-Path -Path $LogDir -ChildPath "intune_sync.log"

# Ensure the log directory exists
if (-Not (Test-Path -Path $LogDir)) {
    try {
        New-Item -Path $LogDir -ItemType Directory -Force | Out-Null
    } catch {
        Write-Host "Failed to create log directory at $LogDir. Error: $_"
        Exit 1
    }
}

# Start logging
Start-Transcript -Path $LogFile -Append

Log-Message "Initiating Intune Policy Sync for Logged-In User."

# Get the currently logged-in user
$loggedInUser = (Get-WmiObject -Class Win32_ComputerSystem | Select-Object -ExpandProperty UserName)

if ($loggedInUser) {
    Log-Message "Logged-In User Detected: $loggedInUser"

    # Extract username and domain
    $userParts = $loggedInUser.Split('\\')
    if ($userParts.Count -eq 2) {
        $domain = $userParts[0]
        $username = $userParts[1]
    } else {
        $domain = ""
        $username = $userParts[0]
    }

    # Define the path to usoclient.exe
    $usoclientPath = "C:\Windows\System32\usoclient.exe"

    if (-Not (Test-Path -Path $usoclientPath)) {
        Log-Message "usoclient.exe not found at $usoclientPath. Exiting script."
        Stop-Transcript
        Exit 1
    }

    # Define the scheduled task action
    $action = New-ScheduledTaskAction -Execute $usoclientPath -Argument "RefreshPolicy Machine, User"

    # Define the trigger to run once immediately
    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddSeconds(30)

    # Define the principal to run as the logged-in user
    $principal = New-ScheduledTaskPrincipal -UserId $loggedInUser -LogonType Interactive -RunLevel Highest

    # Define the task settings
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable

    # Register the scheduled task
    try {
        Register-ScheduledTask -TaskName "IntuneSyncTask_$username" -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force
        Log-Message "Scheduled Task 'IntuneSyncTask_$username' created successfully."
    } catch {
        Log-Message "Failed to create Scheduled Task. Error: $_"
        Stop-Transcript
        Exit 1
    }

    # Run the scheduled task
    try {
        Start-ScheduledTask -TaskName "IntuneSyncTask_$username"
        Log-Message "Scheduled Task 'IntuneSyncTask_$username' started successfully."
    } catch {
        Log-Message "Failed to start Scheduled Task. Error: $_"
    }

    # Optionally, wait for the task to complete
    Start-Sleep -Seconds 60

    # Remove the scheduled task
    try {
        Unregister-ScheduledTask -TaskName "IntuneSyncTask_$username" -Confirm:$false
        Log-Message "Scheduled Task 'IntuneSyncTask_$username' unregistered successfully."
    } catch {
        Log-Message "Failed to unregister Scheduled Task. Error: $_"
    }
} else {
    Log-Message "No user is currently logged in. Intune Policy Sync not triggered."
}

# Stop logging
Stop-Transcript

Log-Message "Intune Policy Sync Script Execution Completed."
